		{"id":"91ec51a9524081f3","type":"text","text":"Пересекает/Проходит рядом","x":-40,"y":-104,"width":297,"height":60,"color":"6"},
		{"id":"bb4e2ddb04d6f438","type":"text","text":"Находится на пересечении ЖД и Реки","x":-16,"y":-220,"width":250,"height":60,"color":"6"},
