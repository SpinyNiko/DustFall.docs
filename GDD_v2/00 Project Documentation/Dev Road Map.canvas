		{"id":"a3e24fda034249ec","type":"text","text":"Правки по отзывам","x":-140,"y":2103,"width":250,"height":60},
		{"id":"b8ec55abf2b8b5c8","type":"text","text":"Оптимизация производительности","x":-140,"y":2183,"width":250,"height":60},
