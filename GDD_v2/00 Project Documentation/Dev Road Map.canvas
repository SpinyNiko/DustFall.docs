		{"id":"352d8d2af227c706","type":"text","text":"Финальное тестирование","x":-140,"y":2491,"width":250,"height":60},
		{"id":"a709b93b0a6620ac","type":"text","text":"Анализ статистики продаж и отзывов","x":-140,"y":3103,"width":334,"height":60},
