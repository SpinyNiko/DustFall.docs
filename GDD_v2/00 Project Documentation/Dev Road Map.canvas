		{"id":"7b082fe1dc3cac55","type":"text","text":"Минимальные тестовые ассеты","x":-140,"y":-740,"width":250,"height":60,"color":"2"},
		{"id":"f28b8707f77ede74","type":"text","text":"Проверка управляемости, физики, реакции игрока","x":-140,"y":-660,"width":250,"height":60},
		{"id":"86ca2a0834d009be","type":"text","text":"Тестирование фидбэка и баланса","x":-140,"y":-580,"width":250,"height":60},
		{"id":"765f7d6c8838dafd","type":"text","text":"Финализация GDD","x":-140,"y":-302,"width":250,"height":60},
		{"id":"70ff118a1aecfc0c","type":"text","text":"Создание технических документов(TDD, Art Bible, Level Design Doc)","x":-140,"y":-225,"width":250,"height":112},
		{"id":"64616b70030983c0","type":"text","text":"Создание roadmap для команды","x":-140,"y":-92,"width":250,"height":60},
